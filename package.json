{
  "name": "pkg-placeholder",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "description": "_description_",
  "author": "leiwang <leiwang2000@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/l246804/starter-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/starter-ts.git"
  },
  "bugs": "https://github.com/l246804/starter-ts/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "skills": [
    { "source": "mattpocock/skills/skills/engineering", "ref": "24fe0ef7737efae15c87225755e9f6f5965e4888" },
    { "source": "mattpocock/skills/skills/productivity", "ref": "24fe0ef7737efae15c87225755e9f6f5965e4888" },
    { "source": "antfu/skills", "ref": "feb0f3aba6566426f12230e7fc7a10d97c1293bb", "skills": ["antfu"] },
    { "source": "anthropics/skills/skills/frontend-design", "ref": "dbd4588f9e1033efb41dad4bef2f7947c8993d44" },
    { "source": "ericlitman/open-pstack/plugins/pstack/skills", "ref": "c5c8e237c324359a3d1929037da78fe66da3d1ed", "skills": ["unslop"] }
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
